# Normalize line endings: LF in the repo, platform-appropriate on checkout.
* text=auto eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.zip binary

*.pth binary
*.onnx binary
*.pt binary
*.npy binary
*.py text eol=lf
*.json text eol=lf
